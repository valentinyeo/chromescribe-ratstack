{
  "name": "chromescribe",
  "version": "0.1.0",
  "private": true,
  "description": "ChromeScribe on Rat Stack: Effect 4, XState 6 with @xstate/effect, Alchemy infra, varlock config, and a lint/typecheck fence that makes cheating uncomfortable.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @chromescribe/web dev",
    "alchemy": "pnpm --filter @chromescribe/infra exec alchemy",
    "build": "turbo run build",
    "bump:checkers": "node scripts/bump-checkers.ts",
    "check": "pnpm run lockfile:check && varlock load && turbo run typecheck typecheck-scripts test:turbo-summary check:turbo-inputs check:landmines --summarize && ultracite check && oxfmt --check .",
    "check:landmines": "node packages/core/scripts/check-landmines.ts",
    "check:turbo-inputs": "node --test scripts/turbo-inputs.test.ts && node scripts/turbo-inputs.ts",
    "cli": "turbo run build --filter=@chromescribe/cli && node apps/cli/dist/cli.js",
    "env:check": "varlock load",
    "fix": "ultracite fix && oxfmt .",
    "lint": "ultracite check && oxfmt --check .",
    "lockfile:check": "pnpm --config.optimistic-repeat-install=false install --frozen-lockfile --offline --lockfile-only --ignore-scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "infra:deploy": "pnpm --filter @chromescribe/infra deploy",
    "infra:destroy": "pnpm --filter @chromescribe/infra destroy",
    "infra:dev": "pnpm --filter @chromescribe/infra dev",
    "infra:plan": "pnpm --filter @chromescribe/infra plan",
    "prepare": "effect-tsgo patch && if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "test": "pnpm test:security-audit && turbo run test",
    "test:security-audit": "node --test skills/security-audit/*.test.cjs",
    "test:turbo-summary": "node --test scripts/turbo-summary.test.ts",
    "turbo:summary": "node scripts/turbo-summary-report.ts",
    "typecheck": "turbo run typecheck typecheck-scripts",
    "typecheck:tsc": "turbo run typecheck:tsc typecheck:tsc-scripts",
    "typecheck:tsc-scripts": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "turbo run typecheck:fast typecheck:fast-scripts",
    "typecheck:fast-scripts": "tsrs --noEmit -p tsconfig.json",
    "typecheck:parity": "pnpm --filter @chromescribe/core typecheck:parity",
    "typecheck-scripts": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "vendor:agent-sources": "./scripts/vendor-agent-sources.sh"
  },
  "devDependencies": {
    "@effect/tsgo": "0.69.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@oxlint/plugins": "1.93.0",
    "@types/node": "24.19.2",
    "@yielded/effect-tsrs": "0.2.3",
    "effect": "4.1.4",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "portless": "0.17.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "ultracite": "8.2.0",
    "varlock": "1.25.0",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.1.2"
  },
  "packageManager": "pnpm@11.3.0"
}

{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": ["pnpm_config_pm_on_fail"],
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "typecheck:tsc": {
      "dependsOn": ["^typecheck:tsc"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "//#typecheck:tsc-scripts": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!skills/**",
        "!assets/**",
        "!.agent_sources/**",
        "!**/*.md"
      ],
      "outputs": []
    },
    "@chromescribe/web#typecheck:tsc": {
      "dependsOn": ["^build", "^typecheck:tsc"],
      "outputs": []
    },
    "typecheck:fast": {
      "dependsOn": ["^typecheck:fast"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "//#typecheck:fast-scripts": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!skills/**",
        "!assets/**",
        "!.agent_sources/**",
        "!**/*.md"
      ],
      "outputs": []
    },
    "@chromescribe/web#typecheck:fast": {
      "dependsOn": ["^build", "^typecheck:fast"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "//#lint": {
      "dependsOn": [],
      "outputs": []
    },
    "//#typecheck-scripts": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!skills/**",
        "!assets/**",
        "!.agent_sources/**",
        "!**/*.md"
      ],
      "outputs": []
    },
    "//#test:turbo-summary": {
      "inputs": ["scripts/turbo-summary*.ts", "package.json"],
      "outputs": []
    },
    "//#check:landmines": {
      "cache": false,
      "passThroughEnv": ["LANDMINES_BASE"],
      "outputs": []
    },
    "//#check:turbo-inputs": {
      "cache": false,
      "outputs": []
    },
    "//#lockfile:check": {
      "cache": false,
      "outputs": []
    },
    "check": {
      "dependsOn": [
        "//#check:landmines",
        "//#check:turbo-inputs",
        "//#lockfile:check",
        "typecheck",
        "//#lint",
        "//#typecheck-scripts",
        "//#test:turbo-summary"
      ],
      "outputs": []
    },
    "@chromescribe/infra#test": {
      "dependsOn": [
        "^build",
        "@chromescribe/web#build",
        "@chromescribe/web#test"
      ],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/src/**",
        "$TURBO_ROOT$/apps/worker/src/**"
      ]
    },
    "@chromescribe/web#typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "@chromescribe/core#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/*",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/vendor/README.md",
        "!$TURBO_ROOT$/apps/*/src/**/*.generated.ts"
      ]
    },
    "@chromescribe/core#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/scripts/checker-age-exceptions.ts",
        "$TURBO_ROOT$/scripts/vcs-command-policy.*",
        "$TURBO_ROOT$/tools/oxlint/landmines/{baseline,finding}.ts"
      ]
    },
    "@chromescribe/core#typecheck:tsc": {
      "dependsOn": ["^typecheck:tsc"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/scripts/checker-age-exceptions.ts",
        "$TURBO_ROOT$/scripts/vcs-command-policy.*",
        "$TURBO_ROOT$/tools/oxlint/landmines/{baseline,finding}.ts"
      ]
    },
    "@chromescribe/core#typecheck:fast": {
      "dependsOn": ["^typecheck:fast"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/scripts/checker-age-exceptions.ts",
        "$TURBO_ROOT$/scripts/vcs-command-policy.*",
        "$TURBO_ROOT$/tools/oxlint/landmines/{baseline,finding}.ts"
      ]
    },
    "@chromescribe/cli#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/skills/security-audit/SKILL.md"
      ]
    },
    "@chromescribe/cli#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "@chromescribe/deploy#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "@chromescribe/deploy#typecheck:tsc": {
      "dependsOn": ["^typecheck:tsc"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "@chromescribe/deploy#typecheck:fast": {
      "dependsOn": ["^typecheck:fast"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "@chromescribe/deploy#test": {
      "dependsOn": ["build", "@chromescribe/web#build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/*",
        "$TURBO_ROOT$/.env.schema",
        "$TURBO_ROOT$/apps/web/dist/server/foldkit.build.json"
      ]
    },
    "@chromescribe/web#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/*"]
    }
  }
}

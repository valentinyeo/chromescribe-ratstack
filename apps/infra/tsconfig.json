{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node/NodeRuntime",
          "@effect/platform-node/NodeServices",
          "@effect/vitest",
          "effect/FileSystem",
          "effect/Path"
        ]
      }
    ]
  },
  "include": ["alchemy.run.ts", "src/**/*.ts", "test/**/*.ts"]
}

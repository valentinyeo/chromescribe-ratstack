{
  "name": "@chromescribe/core",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./flags": {
      "types": "./src/flags.ts",
      "import": "./dist/flags.js",
      "default": "./dist/flags.js"
    },
    "./flag-ledger-engine": {
      "types": "./src/flag-ledger-engine.ts",
      "import": "./dist/flag-ledger-engine.js",
      "default": "./dist/flag-ledger-engine.js"
    },
    "./flag-control": {
      "types": "./src/flag-control.ts",
      "import": "./dist/flag-control.js",
      "default": "./dist/flag-control.js"
    },
    "./flag-write-capabilities": {
      "types": "./src/flag-write-capabilities.ts",
      "import": "./dist/flag-write-capabilities.js",
      "default": "./dist/flag-write-capabilities.js"
    },
    "./flag-capabilities": {
      "types": "./src/flag-capabilities.ts",
      "import": "./dist/flag-capabilities.js",
      "default": "./dist/flag-capabilities.js"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./transcripts": {
      "types": "./src/transcripts.ts",
      "import": "./dist/transcripts.js",
      "default": "./dist/transcripts.js"
    },
    "./transcript-capabilities": {
      "types": "./src/transcript-capabilities.ts",
      "import": "./dist/transcript-capabilities.js",
      "default": "./dist/transcript-capabilities.js"
    }
  },
  "scripts": {
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "typecheck:parity": "vitest run --config vitest.parity.config.ts",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "pretest": "test -n \"$TURBO_HASH\" || pnpm run --silent build"
  },
  "dependencies": {
    "@chromescribe/capability": "workspace:*",
    "@effect/platform-node": "4.1.4",
    "@xstate/effect": "1.0.0-beta.2",
    "effect": "4.1.4",
    "xstate": "6.0.0-beta.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.4",
    "@types/node": "24.19.2",
    "tla-ts": "0.0.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
